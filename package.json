{
  "name": "spora-plugin-team-graph-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Vue IIFE bundle for the Spora team-graph admin view. Renders a per-principal Mermaid graph of agent spawning relationships, lazy-loaded into the host SPA via /plugins/team-graph/main.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.js",
    "clean": "node scripts/clean.js"
  },
  "dependencies": {
    "mermaid": "^10.9.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.0",
    "happy-dom": "^20.8.9",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.2",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.2.0"
  }
}